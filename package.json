{
  "name": "insta-crossel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/start-content-worker.ts",
    "worker:image": "node scripts/run-worker.mjs",
    "worker:image:raw": "ts-node worker/start-worker.ts",
    "worker:logs": "node scripts/worker-logs.mjs",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
